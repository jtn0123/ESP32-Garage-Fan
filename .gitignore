# Local validation and analysis artifacts (do not commit)
out/
validation_reports/
# Throwaway one-off probe scripts -- "drive the console and print what it does"
# while chasing a layout or timing question. They answer one question and are
# deleted; anything worth keeping becomes an e2e spec instead.
*.tmp.mjs

# PlatformIO build artifacts
.pio/
.pioenvs/
.piolibdeps/
compile_commands.json

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.venv/
venv/
ENV/
env/

# Python caches and tooling
.pytest_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.log

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editors
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-*

# Backup and temporary files
*.bak
*.backup
*.orig
*.tmp
*.temp
nohup.out

# Local config
config/device.yaml

# Generated by scripts/gen_device_header.py during the PlatformIO build. Carries
# WIFI_SSID / WIFI_PASS / MQTT_USER / MQTT_PASS inline -- never commit it.
firmware/arduino/src/generated_config.h

# Generated by scripts/gen_web_page.py from web/dist/console.html -- a gzipped
# byte array of the console, rebuilt on every firmware build.
firmware/arduino/src/generated_page.h
firmware/arduino/src/generated_wire.h

# Environment variables with secrets
.env
.env.local
.env.*.local

# Deploy/monitor logs
build.log
mqtt_itest.log

# Node modules for the web console build. web/dist/console.html IS committed:
# the firmware build must work with only Python + PlatformIO, no node.
web/node_modules/

# Playwright output. The suite is the source of truth; these are per-run
# artifacts (traces, screenshots, HTML reports) and must never be committed.
web/test-results/
web/playwright-report/
web/blob-report/
web/.playwright/

# Screenshot sweeps from web/shots.mjs (look at them, do not commit them)
.shots/

# Rust build output (tools/fantape). Cargo.lock IS committed: this is a
# binary, so a reproducible build matters more than dependency flexibility --
# even with no dependencies to pin today.
tools/fantape/target/
